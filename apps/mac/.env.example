# Read only by the Rust backend. Never add a VITE_ prefix.
FABRIC_LOCAL_MODEL=lfm3:1.7b-q4_K_M
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Requests are made only when Send is pressed. Set false to disable them.
FABRIC_CLOUD_ENABLED=true
# Local SearXNG; no web-search API key is required.
FABRIC_SEARCH_URL=http://127.0.0.1:8877
